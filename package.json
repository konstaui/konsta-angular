{
  "name": "konsta",
  "description": "Mobile UI components for Angular made with Tailwind CSS",
  "version": "5.0.4",
  "private": true,
  "license": "MIT",
  "author": "Martin Donadieu",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production node scripts/build",
    "/*============ Angular Kitchen Sink ============*/": "============",
    "dev": "cross-env NODE_ENV=development vite ./kitchen-sink/angular",
    "angular": "cross-env NODE_ENV=development vite ./kitchen-sink/angular",
    "build-angular-ks": "cross-env NODE_ENV=production vite build ./kitchen-sink/angular",
    "/*============ Dev tools ============*/": "============",
    "prettier": "prettier \"**/*.+(js|json|scss|css|less|ts)\"",
    "format": "npm run prettier -- --write",
    "check-format": "npm run prettier -- --list-different",
    "validate": "npm-run-all --parallel check-format",
    "release": "npm run validate && node ./scripts/release",
    "changelog": "npx conventional-changelog -p angular -i CHANGELOG.md -u -s"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.21.2",
    "@angular/animations": "^20.0.0",
    "@angular/build": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.7.4",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^10.0.0",
    "exec-sh": "^0.4.0",
    "framework7-icons": "^5.0.5",
    "fs-extra": "^11.3.0",
    "inquirer": "^12.8.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup": "^4.46.1",
    "rxjs": "^7.8.1",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.6",
    "zone.js": "^0.15.0"
  },
  "dependencies": {
    "konsta": "file:src",
    "tailwind-merge": "^3.3.1"
  }
}
